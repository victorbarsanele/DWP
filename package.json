{
  "name": "distributed-wagering-processor",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "start": "bun run src/main.ts",
    "test": "bun run migrate:test:up && bun test --preload ./test/preload.ts --max-concurrency 1 test/unit test/integration/postgres",
    "test:integration": "bun run migrate:test:up && bun test --preload ./test/preload.ts --max-concurrency 1 test/integration/postgres",
    "test:migration": "bun test --preload ./test/preload.ts ./test/integration/postgres/migration-cycle.int.ts",
    "migrate:test:up": "bun run src/infrastructure/persistence/mikro-orm/migrate.ts test-up",
    "migrate:up": "bun run src/infrastructure/persistence/mikro-orm/migrate.ts up",
    "migrate:down": "bun run src/infrastructure/persistence/mikro-orm/migrate.ts down"
  },
  "dependencies": {
    "@mikro-orm/core": "6.3.13",
    "@mikro-orm/migrations": "6.3.13",
    "@mikro-orm/nestjs": "6.1.2",
    "@mikro-orm/postgresql": "6.3.13",
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "@nestjs/testing": "10.4.15",
    "decimal.js": "10.4.3",
    "pg": "8.12.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "22.5.4",
    "@types/pg": "8.11.10",
    "typescript": "5.5.4"
  }
}
